# Dependencies
node_modules/
**/node_modules/

# Environment & secrets (never commit)
.env
.env.*
!.env.example
backend/.env
frontend/.env

# Build output
dist/
build/
**/dist/
**/build/
.vite/
.cache/

# Logs & debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Test & coverage
coverage/
.nyc_output/

# Uploads (user-generated; use cloud storage in production)
backend/uploads/*
!backend/uploads/.gitkeep

# Temp & local tooling
tmp/
temp/
*.local
.cursor/
terminals/

# Optional local DB dumps
*.sql.gz
dump/
