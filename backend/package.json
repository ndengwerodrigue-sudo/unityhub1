{
  "name": "unity-hub-backend",
  "version": "1.0.0",
  "description": "Backend for The Unity Hub - Cameroon community platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate:engagement": "node scripts/run-engagement-migration.js",
    "migrate:applications": "node scripts/run-applications-migration.js",
    "migrate:notifications": "node scripts/run-notifications-migration.js",
    "migrate:post-media": "node scripts/run-post-media-migration.js",
    "migrate:comments": "node scripts/run-comment-engagement-migration.js",
    "migrate:opportunities-v2": "node -e \"require('dotenv').config(); require('./scripts/run-opportunities-v2-migration')().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\"",
    "migrate:auth": "node -e \"require('dotenv').config(); const { runAuthMigration } = require('./scripts/run-auth-migration'); runAuthMigration().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "node",
    "express",
    "mongodb",
    "jwt",
    "cameroon"
  ],
  "author": "Unity Hub Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
