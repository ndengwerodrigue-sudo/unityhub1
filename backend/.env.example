# Server
PORT=5001
NODE_ENV=development

# Application URLs
APP_URL=http://localhost:5001
OAUTH_CALLBACK_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/unity_hub

# JWT & Sessions (use long random strings in production)
JWT_SECRET=your_secure_random_jwt_secret_change_in_production
JWT_EXPIRE=1d
JWT_REMEMBER_EXPIRE=30d
SESSION_SECRET=your_secure_random_session_secret_change_in_production

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Brevo transactional email
# Verify FROM_EMAIL in Brevo → Senders & IP before sending.
# BREVO_API_KEY is preferred (REST API). SMTP_USER + SMTP_PASS are optional fallback.
# If you see "unrecognised IP", authorize your server IP at:
# https://app.brevo.com/security/authorised_ips
BREVO_API_KEY=your_brevo_api_key_xkeysib
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_login@smtp-brevo.com
SMTP_PASS=your_brevo_smtp_or_api_key
FROM_EMAIL=verified-sender@yourdomain.com
FROM_NAME=Unity Hub
